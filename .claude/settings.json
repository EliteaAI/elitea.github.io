{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/release-notes/scripts/fetch_issues.py *)",
      "Bash(python3 .claude/skills/release-notes/scripts/doc_index.py *)",
      "Bash(python3 .claude/skills/release-notes/scripts/rn_file.py current)",
      "Bash(python3 .claude/skills/release-notes/scripts/rn_file.py status)",
      "Bash(python3 .claude/skills/release-notes/scripts/rn_file.py set *)",
      "Bash(python3 .claude/skills/release-notes/scripts/rn_file.py order *)",
      "Bash(gh issue view *)",
      "Bash(gh api repos/EliteaAI/*)",
      "Read(//tmp/rn/**)",
      "Read(//private/tmp/rn/**)",
      "Write(//tmp/rn/**)",
      "Write(//private/tmp/rn/**)",
      "Bash(python .claude/kit/df.py *)",
      "Bash(cd docs && mint validate*)",
      "Bash(cd docs && mint broken-links*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git -C ../EliteaUI *)",
      "Bash(git -C ../elitea-sdk *)",
      "Bash(git -C ../elitea_core *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/kit/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/kit/hooks/post_edit.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/kit/hooks/session_start.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
